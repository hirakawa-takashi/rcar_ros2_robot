+// 7 セグメントの数字（白・黒いふち）を右上に描く。白と黒は RGB565 のバイト順によらない
+static void fill_rect(uint8_t* data, int w, int h, size_t stride, int x0, int y0, int x1, int y1, uint16_t color)
+{
+    x0 = MAX(x0, 0);
+    y0 = MAX(y0, 0);
+    x1 = MIN(x1, w);
+    y1 = MIN(y1, h);
+    for (int y = y0; y < y1; y++) {
+        auto row = (uint16_t*)(data + y * stride);
+        for (int x = x0; x < x1; x++) {
+            row[x] = color;
+        }
+    }
+}
+
+static void draw_count(uint8_t* data, int w, int h, size_t stride, int count)
+{
+    // a b c d e f g
+    static const uint8_t kSegments[10] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};
+    const int W = 80, H = 140, T = 18, B = 4;
+    const int ox = w - W - 16, oy = 16;
+    const int seg[7][4] = {
+        {ox, oy, ox + W, oy + T},                                // a
+        {ox + W - T, oy, ox + W, oy + H / 2},                    // b
+        {ox + W - T, oy + H / 2, ox + W, oy + H},                // c
+        {ox, oy + H - T, ox + W, oy + H},                        // d
+        {ox, oy + H / 2, ox + T, oy + H},                        // e
+        {ox, oy, ox + T, oy + H / 2},                            // f
+        {ox, oy + (H - T) / 2, ox + W, oy + (H + T) / 2},        // g
+    };
+    uint8_t mask = kSegments[count % 10];
+    for (int pass = 0; pass < 2; pass++) {
+        int b           = pass == 0 ? B : 0;
+        uint16_t color  = pass == 0 ? 0x0000 : 0xFFFF;
+        for (int i = 0; i < 7; i++) {
+            if (mask & (1 << i)) {
+                fill_rect(data, w, h, stride, seg[i][0] - b, seg[i][1] - b, seg[i][2] + b, seg[i][3] + b, color);
+            }
+        }
+    }
+}
