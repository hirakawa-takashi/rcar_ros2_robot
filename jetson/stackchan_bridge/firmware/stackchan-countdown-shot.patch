+bool StackChanCamera::RequestShot(int seconds)
+{
+    if (frame_task_ == nullptr) {
+        return false;
+    }
+    shot_seconds_ = seconds;
+    xTaskNotifyGive(frame_task_);
+    return true;
+}
+
+bool StackChanCamera::PreviewFrame(int count)
+{
+    std::lock_guard<std::mutex> lock(frame_mutex_);
+    return StreamCaptures() && ShowPreview(count);
+}
+
+// 数えながら画面にカメラを出し、0 で撮って /camera/shot へ送る
+void StackChanCamera::DoShot(int seconds)
+{
+    ESP_LOGI(TAG, "shot: %d s", seconds);
+    int64_t end = esp_timer_get_time() + seconds * 1000000LL;
+    int shown   = 0;
+    for (int64_t left; (left = end - esp_timer_get_time()) > 0;) {
+        int count = (int)((left + 999999) / 1000000);
+        if (count != shown) {
+            shown = count;
+            hal_bridge::app_play_sound(Lang::Sounds::OGG_POPUP);
+        }
+        PreviewFrame(count);
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    if (!Capture()) {
+        ESP_LOGE(TAG, "shot: capture failed");
+        return;
+    }
+    std::string url = frame_url_.substr(0, frame_url_.rfind('/')) + "/shot";
+    uint8_t* jpeg   = nullptr;
+    size_t jpeg_len = 0;
+    {
+        std::lock_guard<std::mutex> lock(frame_mutex_);
+        if (!frame_.data ||
+            !image_to_jpeg(frame_.data, frame_.len, frame_.width ? frame_.width : 320,
+                           frame_.height ? frame_.height : 240, frame_.format, SHOT_JPEG_QUALITY, &jpeg, &jpeg_len) ||
+            jpeg == nullptr) {
+            ESP_LOGE(TAG, "shot: jpeg failed");
+            return;
+        }
+    }
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp();
+    http->SetTimeout(10000);
+    http->SetHeader("Device-Id", SystemInfo::GetMacAddress().c_str());
+    http->SetHeader("Content-Type", "image/jpeg");
+    http->SetContent(std::string((const char*)jpeg, jpeg_len));
+    free(jpeg);
+    if (!http->Open("POST", url)) {
+        ESP_LOGE(TAG, "shot: upload failed");
+        return;
+    }
+    int code = http->GetStatusCode();
+    http->ReadAll();
+    http->Close();
+    ESP_LOGI(TAG, "shot: sent %u bytes, %d", (unsigned)jpeg_len, code);
+}
+
 void StackChanCamera::FrameUploadTask(void* arg)
 {
     auto self = static_cast<StackChanCamera*>(arg);
     bool want = false;
     vTaskDelay(pdMS_TO_TICKS(FRAME_ERROR_INTERVAL_MS));
     while (true) {
+        int seconds = self->shot_seconds_.exchange(0);
+        if (seconds > 0) {
+            self->DoShot(seconds);
+            continue;
+        }
         int64_t start = esp_timer_get_time();
         int r         = self->UploadFrame(want);
         want          = r == 1;
         int wait_ms   = r == 1 ? FRAME_MIN_INTERVAL_MS - (int)((esp_timer_get_time() - start) / 1000)
                         : r == 0 ? FRAME_IDLE_INTERVAL_MS
                                  : FRAME_ERROR_INTERVAL_MS;
-        vTaskDelay(pdMS_TO_TICKS(wait_ms > 10 ? wait_ms : 10));
+        ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(wait_ms > 10 ? wait_ms : 10));
     }
 }
 
