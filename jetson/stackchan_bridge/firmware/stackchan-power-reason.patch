+    virtual std::string GetDeviceStatusJson() override
+    {
+        auto json = WifiBoard::GetDeviceStatusJson();
+        auto root = cJSON_Parse(json.c_str());
+        if (root == nullptr || pmic_ == nullptr) {
+            cJSON_Delete(root);
+            return json;
+        }
+        auto power = cJSON_CreateObject();
+        cJSON_AddNumberToObject(power, "on_source", pmic_->power_on_source);
+        cJSON_AddNumberToObject(power, "off_source", pmic_->power_off_source);
+        cJSON_AddNumberToObject(power, "off_after_clear", pmic_->power_off_after_clear);
+        cJSON_AddNumberToObject(power, "reset_reason", esp_reset_reason());
+        cJSON_AddItemToObject(root, "power", power);
+        auto str = cJSON_PrintUnformatted(root);
+        std::string out = str ? str : json;
+        cJSON_free(str);
+        cJSON_Delete(root);
+        return out;
+    }
