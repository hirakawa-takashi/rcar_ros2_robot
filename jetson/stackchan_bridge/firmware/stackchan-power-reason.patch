     // Power Init
     Pmic(i2c_master_bus_handle_t i2c_bus, uint8_t addr) : Axp2101(i2c_bus, addr)
     {
+        // 電源の IC が覚えている「前に入った理由（0x20）・前に切れた理由（0x21）」
+        power_on_source  = ReadReg(0x20);
+        power_off_source = ReadReg(0x21);
+        ESP_LOGW(TAG, "AXP2101 power on source=0x%02X, power off source=0x%02X", power_on_source, power_off_source);
+        // 読んだら消す（W1C を試し、残ったら 0 を書く）。次に切れたときの理由と混ざらないように
+        WriteReg(0x20, 0xFF);
+        WriteReg(0x21, 0xFF);
+        power_off_after_clear = ReadReg(0x21);
+        if (power_off_after_clear != 0) {
+            WriteReg(0x20, 0x00);
+            WriteReg(0x21, 0x00);
+            power_off_after_clear = ReadReg(0x21);
+        }
+        ESP_LOGW(TAG, "AXP2101 power off source after clear=0x%02X", power_off_after_clear);
         uint8_t data = ReadReg(0x90);
         data |= 0b10110100;
         WriteReg(0x90, data);
