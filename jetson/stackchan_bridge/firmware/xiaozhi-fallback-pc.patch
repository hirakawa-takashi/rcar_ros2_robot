+++ b/main/aicar_server.h
@@ -0,0 +1,34 @@
+#pragma once
+// AI-CAR: the StackChan bridge runs on the mini PC (host of CONFIG_OTA_URL) and, as a standby, on the PC.
+// Try the mini PC first and the PC when the mini PC does not answer (same ports and paths).
+#include <string>
+
+#include "sdkconfig.h"
+
+#define AICAR_FALLBACK_HOST "192.168.11.7"
+
+inline std::string AicarHostOf(const std::string& url) {
+    auto b = url.find("://");
+    if (b == std::string::npos) {
+        return "";
+    }
+    b += 3;
+    auto e = url.find_first_of(":/", b);
+    return url.substr(b, e == std::string::npos ? std::string::npos : e - b);
+}
+
+inline std::string AicarWithHost(const std::string& url, const std::string& host) {
+    auto b = url.find("://");
+    if (b == std::string::npos) {
+        return url;
+    }
+    b += 3;
+    auto e = url.find_first_of(":/", b);
+    return url.substr(0, b) + host + (e == std::string::npos ? "" : url.substr(e));
+}
+
+// The bridge URLs to try for url: the mini PC first, then the PC. Other servers are tried as they are.
+inline bool AicarIsBridge(const std::string& url) {
+    auto host = AicarHostOf(url);
+    return host == AicarHostOf(CONFIG_OTA_URL) || host == AICAR_FALLBACK_HOST;
+}
