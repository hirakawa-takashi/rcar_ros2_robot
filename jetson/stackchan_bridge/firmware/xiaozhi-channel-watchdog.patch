+// Called every second. A channel that died without a close event (server gone, no data for 120 s)
+// is closed here so the reopen starts. A channel closed for 1 minute (even by a tap) is reopened,
+// and one closed for 3 minutes reboots the device.
+void Application::CheckAudioChannel() {
+    if (!protocol_) {
+        return;
+    }
+    auto state = GetDeviceState();
+    bool opened = protocol_->IsAudioChannelOpened();
+    if (!opened && (state == kDeviceStateListening || state == kDeviceStateSpeaking)) {
+        if (++stale_secs_ == 5) {
+            ESP_LOGW(TAG, "Audio channel lost in state %d, closing it to reopen", (int)state);
+            protocol_->CloseAudioChannel();
+        } else if (stale_secs_ == 15) {
+            ESP_LOGW(TAG, "Audio channel still lost, back to idle");
+            SetDeviceState(kDeviceStateIdle);
+            ScheduleReopen();
+        }
+    } else {
+        stale_secs_ = 0;
+    }
+    bool watching = state == kDeviceStateIdle || state == kDeviceStateConnecting ||
+                    state == kDeviceStateListening || state == kDeviceStateSpeaking;
+    if (!opened && watching) {
+        ++closed_secs_;
+        if (closed_secs_ == 60 && state == kDeviceStateIdle && reopen_in_ == 0) {
+            ESP_LOGW(TAG, "Audio channel closed for 60 s, reopening");
+            user_closed_ = false;
+            ScheduleReopen();
+        } else if (closed_secs_ >= 180) {
+            ESP_LOGE(TAG, "Audio channel closed for %d s, rebooting", closed_secs_);
+            closed_secs_ = 0;
+            Reboot();
+        }
+    } else {
+        closed_secs_ = 0;
+    }
+}
