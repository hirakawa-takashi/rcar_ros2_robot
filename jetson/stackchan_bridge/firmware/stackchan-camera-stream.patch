+#define FRAME_JPEG_QUALITY 30
+#define FRAME_MIN_INTERVAL_MS 150
+#define FRAME_IDLE_INTERVAL_MS 2000
+#define FRAME_ERROR_INTERVAL_MS 5000
+
+void StackChanCamera::StartFrameUpload(const std::string& url)
+{
+    if (frame_task_ != nullptr || url.empty()) {
+        return;
+    }
+    frame_url_ = url;
+    ESP_LOGI(TAG, "frame upload: %s", frame_url_.c_str());
+    xTaskCreate(FrameUploadTask, "cam_frame", 6144, this, 1, &frame_task_);
+}
+
+// 1: 続けて送ってほしい, 0: 今は見ている人がいない, -1: 送れなかった
+int StackChanCamera::UploadFrame(bool want)
+{
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp();
+    http->SetTimeout(5000);
+    http->SetHeader("Device-Id", SystemInfo::GetMacAddress().c_str());
+    if (want) {
+        uint8_t* jpeg   = nullptr;
+        size_t jpeg_len = 0;
+        {
+            std::lock_guard<std::mutex> lock(frame_mutex_);
+            if (!StreamCaptures() ||
+                !image_to_jpeg(frame_.data, frame_.len, frame_.width ? frame_.width : 320,
+                               frame_.height ? frame_.height : 240, frame_.format, FRAME_JPEG_QUALITY, &jpeg,
+                               &jpeg_len) ||
+                jpeg == nullptr) {
+                return -1;
+            }
+        }
+        http->SetHeader("Content-Type", "image/jpeg");
+        http->SetContent(std::string((const char*)jpeg, jpeg_len));
+        free(jpeg);
+    }
+    if (!http->Open(want ? "POST" : "GET", frame_url_)) {
+        return -1;
+    }
+    int code          = http->GetStatusCode();
+    std::string reply = http->ReadAll();
+    http->Close();
+    if (code != 200) {
+        return -1;
+    }
+    return reply.rfind("1", 0) == 0 ? 1 : 0;
+}
+
+void StackChanCamera::FrameUploadTask(void* arg)
+{
+    auto self = static_cast<StackChanCamera*>(arg);
+    bool want = false;
+    vTaskDelay(pdMS_TO_TICKS(FRAME_ERROR_INTERVAL_MS));
+    while (true) {
+        int64_t start = esp_timer_get_time();
+        int r         = self->UploadFrame(want);
+        want          = r == 1;
+        int wait_ms   = r == 1 ? FRAME_MIN_INTERVAL_MS - (int)((esp_timer_get_time() - start) / 1000)
+                        : r == 0 ? FRAME_IDLE_INTERVAL_MS
+                                 : FRAME_ERROR_INTERVAL_MS;
+        vTaskDelay(pdMS_TO_TICKS(wait_ms > 10 ? wait_ms : 10));
+    }
+}
