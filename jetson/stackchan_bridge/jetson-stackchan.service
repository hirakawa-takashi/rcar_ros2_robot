[Unit]
Description=StackChan local AI bridge (XiaoZhi OTA + WebSocket -> whisper / Ollama / Kokoro)
After=network-online.target whisper-server.service ollama.service docker.service
Wants=network-online.target

[Service]
User=jetson
# face_id に顔を登録するときの X-API-Token（AI_CAR_API_TOKEN）
EnvironmentFile=-/etc/jetson-status.env
ExecStart=/usr/bin/python3 -u /home/jetson/stackchan_bridge/stackchan_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
